generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// The user's own Gemini API key, AES-256-GCM encrypted (see lib/crypto.ts). Null until they add one.
  geminiKeyEnc   String?
  /// Last 4 characters of the key, shown in the UI so users can tell which key is saved.
  geminiKeyLast4 String?
  /// The user's own OpenAI API key, AES-256-GCM encrypted. Null until they add one.
  openaiKeyEnc   String?
  openaiKeyLast4 String?
  createdAt    DateTime @default(now())
  /// Access status. Defaults to APPROVED so installs without REQUIRE_APPROVAL (local dev) are never blocked;
  /// the register route creates PENDING users only when approval is enabled.
  status       UserStatus @default(APPROVED)
  isAdmin      Boolean    @default(false)
  lastLoginAt  DateTime?
  loginCount   Int        @default(0)
  decidedAt    DateTime?
  folders      Folder[]
  files        File[]
  usage        UsageEntry[]
  logins       LoginEvent[]
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One row per successful login, for activity analytics (daily/weekly/monthly active users).
model LoginEvent {
  id     String   @id @default(cuid())
  userId String
  at     DateTime @default(now())
  /// "mobile" | "desktop", from the User-Agent only (no IP or location is stored).
  device String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([at])
  @@index([userId, at])
}

/// Small key/value store (e.g. marks that the one-time approval migration has run).
model AppSetting {
  key   String @id
  value String
}

/// One billable OpenAI speech request (a finished conversion or a voice sample),
/// with its estimated cost. Kept after a file is deleted, so monthly totals stay true.
model UsageEntry {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  model     String
  voice     String
  chars     Int
  seconds   Float
  costUsd   Float
  fileName  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  userId    String
  parentId  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  files     File[]
  createdAt DateTime @default(now())
}

model File {
  id        String     @id @default(cuid())
  name      String
  path      String
  mimeType  String
  status    FileStatus @default(PENDING)
  userId    String
  folderId  String?
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  audioJob  AudioJob?
  createdAt DateTime   @default(now())
}

model AudioJob {
  id           String   @id @default(cuid())
  fileId       String   @unique
  audioPath    String?
  duration     Float?
  progress     Int      @default(0)
  lastPosition Float    @default(0)
  file         File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum FileStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}
