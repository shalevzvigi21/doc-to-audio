# Used by `docker compose up`. Copy to `.env` and fill in the two secrets.
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Signs login tokens. Required in production.
JWT_SECRET=

# Encrypts the Gemini API keys users save in the app. Keep it stable: if it
# changes, users have to enter their key again. Leave empty to derive it from
# JWT_SECRET.
ENCRYPTION_KEY=

# Where the browser reaches the API and the web app. Change both when you
# deploy to a real domain.
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# OPTIONAL shared Gemini key. Normally leave empty: each user adds their own
# key inside the app.
GEMINI_API_KEY=
